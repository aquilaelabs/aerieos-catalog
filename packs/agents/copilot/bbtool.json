{
 "about": "Copilot CLI, run by sessions as copilot",
 "agent": {
  "allow": {
   "flag": "--allow-tool",
   "how": "flag",
   "rule": "shell({cmd}:*)"
  },
  "briefing": "instructions-file",
  "command": "copilot",
  "guards": "hooks",
  "install": {
   "also": [],
   "bin": ".local/bin/copilot",
   "env": {
    "PREFIX": "{home}/.local"
   },
   "fresh": "",
   "pin": [
    "VERSION",
    "v{v}"
   ],
   "rev": 1,
   "script": "curl -fsSL https://gh.io/copilot-install | bash"
  },
  "latest_url": "https://registry.npmjs.org/@github/copilot/latest",
  "login_job": "copilot-login",
  "logout_job": "copilot-logout",
  "product": "Copilot CLI",
  "provider": "GitHub",
  "reported": "copilot",
  "signin": {
   "env": {
    "COPILOT_AUTO_UPDATE": "false"
   },
   "flow": {
    "answers": [
     {
      "send": "y",
      "when": "plaintext config file"
     }
    ],
    "code_after": "enter code",
    "ends": "exit",
    "forget": {
     "keys": [
      "lastLoggedInUser",
      "loggedInUsers"
     ],
     "like": "token"
    },
    "kept": ".copilot/config.json",
    "url": "https://github.com/login/device",
    "who": {
     "email": [
      "lastLoggedInUser",
      "login"
     ]
    }
   },
   "login": [
    "copilot",
    "login",
    "--device-code"
   ]
  },
  "state": "hooks",
  "tool": "copilot-cli",
  "transcripts": ".copilot/session-state",
  "update_job": "copilot-update"
 },
 "framework": "2.2",
 "label": "Copilot",
 "maker": "GitHub",
 "name": "copilot",
 "platforms": [
  "linux/*"
 ],
 "terms": [],
 "tier": "official"
}
