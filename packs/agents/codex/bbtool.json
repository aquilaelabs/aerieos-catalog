{
 "about": "Codex CLI, run by sessions as codex",
 "agent": {
  "allow": {
   "file": ".codex/rules/aerieos.rules",
   "how": "rules-file",
   "rule": "prefix_rule(pattern={argv}, decision=\"allow\")"
  },
  "briefing": "instructions-file",
  "command": "codex",
  "guards": "hooks",
  "install": {
   "also": [],
   "bin": ".local/bin/codex",
   "env": {
    "CODEX_INSTALL_DIR": "{home}/.local/bin"
   },
   "fresh": "",
   "pin": [
    "CODEX_RELEASE",
    "{v}"
   ],
   "rev": 1,
   "script": "curl -fsSL https://chatgpt.com/codex/install.sh | sh"
  },
  "latest_url": "https://registry.npmjs.org/@openai/codex/latest",
  "login_job": "codex-login",
  "logout_job": "codex-logout",
  "product": "Codex CLI",
  "provider": "OpenAI",
  "reported": "codex",
  "signin": {
   "flow": {
    "code_after": "Enter this one-time code",
    "ends": "exit",
    "kept": ".codex/auth.json",
    "logout": [
     "codex",
     "logout"
    ],
    "url": "https://auth.openai.com/",
    "who": {
     "email": [
      "tokens",
      "id_token",
      "email"
     ],
     "key": [
      "OPENAI_API_KEY"
     ],
     "key_named": "an OpenAI API key",
     "plan": [
      "tokens",
      "id_token",
      "https://api.openai.com/auth",
      "chatgpt_plan_type"
     ]
    }
   },
   "login": [
    "codex",
    "login",
    "--device-auth"
   ]
  },
  "state": "hooks",
  "tool": "codex-cli",
  "transcripts": ".codex/sessions",
  "update_job": "codex-update"
 },
 "framework": "2.2",
 "label": "ChatGPT",
 "maker": "OpenAI",
 "name": "codex",
 "platforms": [
  "linux/*"
 ],
 "terms": [],
 "tier": "official"
}
