{
 "about": "Grok Build, run by sessions as grok",
 "agent": {
  "allow": {
   "flag": "--allow",
   "how": "flag",
   "rule": "Bash({cmd}:*)"
  },
  "briefing": "system-prompt-file",
  "command": "grok",
  "guards": "hooks",
  "install": {
   "also": [],
   "bin": ".local/bin/grok",
   "env": {
    "GROK_BIN_DIR": "{home}/.local/bin"
   },
   "fresh": "",
   "pin": [
    "BB_PIN",
    "{v}"
   ],
   "rev": 1,
   "script": "curl -fsSL https://x.ai/cli/install.sh | bash -s -- ${BB_PIN:-}"
  },
  "latest_url": "https://x.ai/cli/stable",
  "login_job": "grok-login",
  "logout_job": "grok-logout",
  "product": "Grok Build",
  "provider": "xAI",
  "reported": "grok",
  "signin": {
   "env": {
    "GROK_DISABLE_AUTOUPDATER": "1"
   },
   "flow": {
    "code_after": "Confirm this code in your browser",
    "ends": "exit",
    "kept": ".grok/auth.json",
    "logout": [
     "grok",
     "logout"
    ],
    "url": [
     "https://accounts.x.ai/",
     "https://auth.x.ai/",
     "https://x.ai/",
     "https://grok.com/"
    ],
    "who": {
     "named": "an xAI account"
    }
   },
   "login": [
    "grok",
    "login",
    "--device-auth"
   ]
  },
  "state": "hooks",
  "tool": "grok-build",
  "transcripts": ".grok/sessions",
  "update_job": "grok-update"
 },
 "framework": "2.2",
 "label": "Grok",
 "maker": "xAI",
 "name": "grok",
 "platforms": [
  "linux/*"
 ],
 "terms": [],
 "tier": "official"
}
