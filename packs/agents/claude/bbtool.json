{
 "about": "Claude Code, run by sessions as claude",
 "agent": {
  "allow": {
   "how": "settings",
   "rule": "Bash({cmd} *)"
  },
  "briefing": "system-prompt-file",
  "command": "claude",
  "guards": "hooks",
  "install": {
   "also": [
    ".local/share/claude"
   ],
   "bin": ".local/bin/claude",
   "env": {},
   "fresh": ".local/share/claude/versions/{v}",
   "pin": null,
   "rev": 1,
   "script": "curl -fsSL https://claude.ai/install.sh | bash"
  },
  "latest_url": "",
  "login_job": "claude-login",
  "logout_job": "claude-logout",
  "product": "Claude Code",
  "provider": "Anthropic",
  "reported": "claude",
  "signin": {
   "flow": {
    "ends": "exit",
    "kept": ".claude/.credentials.json",
    "logout": [
     "claude",
     "auth",
     "logout"
    ],
    "prompt": "Paste code",
    "refused": "Invalid code",
    "url": [
     "https://claude.com/",
     "https://console.anthropic.com/",
     "https://platform.claude.com/"
    ],
    "who": {
     "email": [
      "oauthAccount",
      "emailAddress"
     ],
     "file": ".claude.json"
    }
   },
   "login": [
    "claude",
    "auth",
    "login"
   ]
  },
  "state": "hooks",
  "tool": "claude-code",
  "transcripts": ".claude/projects",
  "update_job": "claude-update"
 },
 "framework": "2.2",
 "label": "Claude",
 "maker": "Anthropic",
 "name": "claude",
 "platforms": [
  "linux/*"
 ],
 "terms": [],
 "tier": "official"
}
