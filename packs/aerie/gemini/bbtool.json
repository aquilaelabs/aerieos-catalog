    },
    "platform": "linux/amd64",
    "sha256": "408f902da6fce5a45ef777c246c182f6ef263eb155cc26548b910cdbc792dfd9",
    "to": "dl/cli.tar.gz",
    "track": {
     "match": "/antigravity-cli/([0-9][0-9A-Za-z.+_-]*)/",
