     "resolver": "match",
     "url": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json"
    },
    "url": "https://storage.googleapis.com/antigravity-public/antigravity-cli/{version}/linux-arm-musl/cli_linux_arm64_musl.tar.gz",
    "version": "1.5.6-6212266538958848"
   }
  ],
  "steps": [
   [
    "sh",
    "{dir}/install.sh"
   ]
  ],
  "verify": [
   "sh",
   "{dir}/verify.sh"
  ]
 },
 "label": "Gemini",
 "layout": {
