{
 "about": "Google's coding agent, Antigravity CLI (agy), as a session's agent beside the ones AerieOS ships: handed the briefing and held by the same guards through its own hooks. It signs in with a Google account, from its page or in its own terminal, or runs on a Gemini API key.",
 "agent": {
  "allow": {
   "how": "hook"
  },
  "briefing": {
   "how": "hook"
  },
  "command": "agy",
  "first_prompt": {
   "flag": "-i",
   "how": "flag"
  },
  "hooks": {
   "answers": {
    "pre": {
     "approve": {
      "decision": "auto_approve"
     },
     "pass": {
      "decision": "allow"
     },
     "refuse": {
      "decision": "deny",
      "reason": "{reason}"
     },
     "say": {
      "decision": "allow",
      "reason": "{text}"
     }
    },
    "prompt": {
     "refuse": {
      "injectSteps": [
       {
        "errorMessage": {
         "userMessage": "{reason}"
        }
       }
      ],
      "terminationBehavior": "terminate"
     },
     "say": {
      "injectSteps": [
       {
        "systemMessage": {
         "systemMessage": "{text}"
        }
       }
      ]
     }
    },
    "start": {
     "say": {
      "injectSteps": [
       {
        "systemMessage": {
         "systemMessage": "{text}"
        }
       }
      ]
     }
    },
    "stop": {
     "pass": {
      "decision": "allow"
     },
     "refuse": {
      "decision": "continue",
      "reason": "{reason}"
     }
    }
   },
   "document": {
    "entries": {
     "pre": [
      {
       "hooks": [
        "{handler}"
       ],
       "matcher": "*"
      }
     ]
    },
    "entry": [
     "{handler}"
    ],
    "handler": {
     "command": "{command}",
     "timeout": "{seconds}",
     "type": "command"
    },
    "keep": true,
    "under": [
     "aerieos"
    ]
   },
   "events": {
    "pre": "PreToolUse",
    "prompt": "PreInvocation",
    "start": "SessionStart",
    "stop": "Stop"
   },
   "file": ".gemini/config/hooks.json",
   "payload": {
    "args": {
     "command": "CommandLine",
     "file": [
      "TargetFile",
      "Path"
     ],
     "pattern": "Query"
    },
    "call": "invocationNum",
    "cwd": [
     "cwd",
     "toolCall.args.Cwd"
    ],
    "input": "toolCall.args",
    "prompt": "lastUserInput",
    "session": "conversationId",
    "tool": "toolCall.name",
    "transcript": "transcriptPath"
   },
   "prompt_fires": "each-call",
   "tools": {
    "edit": [
     "write_to_file",
     "replace_file_content",
     "multi_replace_file_content",
     "write_file",
     "edit_file"
    ],
    "grep": [
     "grep_search"
    ],
    "shell": [
     "run_command"
    ]
   }
  },
  "name": "Gemini",
  "product": "Antigravity CLI",
  "provider": "Google",
  "respawn": [
   "--continue"
  ],
  "signin": {
   "flow": {
    "answers": [
     {
      "send": "",
      "when": "Select login method"
     }
    ],
    "kept": ".gemini/antigravity-cli/antigravity-oauth-token",
    "prompt": "paste the authorization code",
    "refused": "Got an error",
    "url": "https://accounts.google.com/o/oauth2/"
   },
   "login": [
    "agy"
   ]
  },
  "transcripts": {
   "dir": ".gemini/antigravity/brain",
   "file": "{session}/.system_generated/logs/transcript.jsonl",
   "session_key": "conversationId"
  }
 },
 "format": 5,
 "framework": "5.2",
